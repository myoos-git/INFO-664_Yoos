


import csv # brings all the csv-related functions

# the open function takes these three arguments:
# -the file name / path 
# - "r" for read
# - and the encoding types

with open("moma_artists.csv", "r", encoding="utf-8") as file:
    reader = csv.DictReader(file) # read the file as dictionary object
    data = list(reader) # convert that dictionary object into a usable list called "data"



# STEP 1 : REMOVE ALL ENTRIES WITH NO YEAR!

artists_with_year = [] # new list to hold our artists that have your data

for artist in data: # for each artist in the dataset..
    if artist['BeginDate'] != "0":
        artists_with_year.append(artist)
print(len(artists_with_year))


year_counts = {} # empty DICTIONARY to store year counts
for artist in artists_with_year: # go through each artist in the filtered list
    year = artist['BeginDate'] #store the begin date for each artist, this is a string 
    if year in year_counts: #check to see if that begin date is in the year_counts dictionary
        year_counts[year] = year_counts[year]+1 # if true, add one to existing count
    else:
        year_counts[year] = 1 # if that year isn't in the dictionary, create a key for the year and set value to 1
print(year_counts['1956'])
        


sorted_years = sorted(year_counts, key=lamda year_counts[year], reverse=True)
print(sorted_years[:10])








import csv   # brings in all the csv-related functions

with open("moma_art.csv", "r", encoding="utf-8") as file:
    reader = csv.DictReader(file)   # read the file as dictionaries
    data = list(reader)             # convert that into a usable list called "data"
print(dat[0].keys())





# filtering the large dataset into a smaller list of dictionaries with only works by Yoko Ono

yoko_ono_artworks = []

for artwork in data:
    if artwork['Artist'] == "Yoko Ono":
        yoko_ono_artworks.append(artwork)

print(len(yoko_ono_artworks))



with open("yoko_ono_artworks.csv", "w", encoding="utf-8") as file:
    writer = csv.DictWriter(file, yoko_ono_artworks[0].keys()) #specifying the keys in yoko_ono_artworks as the columns in the CSV
    writer.writeheader() #create the first row of the csv, containing the headers
    writer.writerows(yoko_ono_artworks) 






